# Server
PORT=5001
NODE_ENV=development

# MongoDB (local ya Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/independence_day_portal

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRE=7d

# Frontend URL (CORS ke liye)
CLIENT_URL=http://localhost:5173

# AI Quiz Generator (OPTIONAL)
# Agar key nahi doge to app automatically local template-based
# question generator use karega (koi error nahi aayega).
ANTHROPIC_API_KEY=
